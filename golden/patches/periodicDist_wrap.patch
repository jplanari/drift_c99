 inline double periodicDist(cv::Point p1, cv::Point p2, int w, int h) {
-    return std::sqrt(std::pow(p1.x - p2.x, 2) + std::pow(p1.y - p2.y, 2));
+    // Shortest distance on the wrapped sensor ("Pac-Man"): the axis difference is taken
